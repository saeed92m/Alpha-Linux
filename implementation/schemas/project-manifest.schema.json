{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-linux.invalid/schemas/project-manifest.schema.json",
  "title": "Alpha Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "schema_version", "toolchain", "environment", "inputs", "outputs", "resources", "platform", "recovery"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "toolchain": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resources": {"type": "object", "additionalProperties": {"type": "string"}},
    "platform": {"type": "string", "minLength": 1},
    "recovery": {"type": "string", "minLength": 1}
  }
}
